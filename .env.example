# Rankify-PDF2CBT — env example
# Copy to .env.local for dev. On Vercel: Project Settings → Environment Variables.
# NEVER commit real keys — this file ships to GitHub, values stay empty.

# --- AI providers (SERVER-ONLY — no VITE_ prefix, read via /api/agent/chat) ---
# Blank client key + env set → request routes through the proxy (recommended).
# If unset, user must paste their own key in-app (BYOK). See src/config/providers.yaml
# for which envKey each provider needs.
MISTRAL_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
POOLSIDE_API_KEY=
AGNES_API_KEY=
INFERX_API_KEY=
OPENCODE_CUSTOM_API_KEY=

# --- Feedback → Discord (SERVER-ONLY, optional) ---
# Create in Discord: channel settings → Integrations → Webhooks → Copy URL.
# Paste ONLY in Vercel env vars, never here. Empty = feedback saves locally + GitHub fallback.
FEEDBACK_WEBHOOK_URL=
# (alt) Telegram instead of Discord:
# FEEDBACK_TELEGRAM_BOT_TOKEN=
# FEEDBACK_TELEGRAM_CHAT_ID=

# --- GTM (CLIENT, optional, open-source safe) ---
# Your container ID from tagmanager.google.com → Admin → Install GTM.
# Public by design (visible in page source), but keep it OUT of the repo so
# forks don't send data to YOUR container. Set ONLY in Vercel → Env Vars.
# Empty = GTM never loads (dev + forks send nothing). Free tier, no server cost.
# Vercel: Key=VITE_GTM_ID Value=GTM-XXXXXXX Envs=Production (+Preview to test)
VITE_GTM_ID=

# --- Optional: Generic ---
# NODE_ENV=production

# --- Notes ---
# Preconfigured providers live in src/config/providers.yaml (edit on GitHub).
# Each preset declares its own "envKey" — the Vercel env var name above.
# When a user leaves the client key blank, requests route through
# /api/agent/chat which reads that env var server-side. Users can also add
# private local providers in-browser (Extract → AI Agent → Settings).
# Docs:
#  Mistral  https://docs.mistral.ai/api/endpoint/chat
#  Groq     https://console.groq.com/docs/api-reference
#  NVIDIA   https://docs.api.nvidia.com/nim/reference/create_chat_completion_v1_chat_completions_post-1
