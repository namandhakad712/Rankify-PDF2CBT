{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "#layers/shared/app/lib/utils": ["src/lib/utils.ts"],
      "#layers/*": ["src/types/shims.d.ts"]
    },
    "skipLibCheck": true,

    /* Linting — relaxed for exact V1 port (Home + heavy deps) */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/components/MainNavBar.vue",
    "src/components/ui/accordion/**",
    "src/components/ui/badge/**",
    "src/components/ui/button/**",
    "src/components/ui/card/**",
    "src/components/ui/checkbox/**",
    "src/components/ui/combobox/**",
    "src/components/ui/context-menu/**",
    "src/components/ui/dialog/**",
    "src/components/ui/dropdown-menu/**",
    "src/components/ui/hover-card/**",
    "src/components/ui/input/**",
    "src/components/ui/label/**",
    "src/components/ui/navigation-menu/**",
    "src/components/ui/number-field/**",
    "src/components/ui/popover/**",
    "src/components/ui/progress/**",
    "src/components/ui/resizable/**",
    "src/components/ui/scroll-area/**",
    "src/components/ui/select/**",
    "src/components/ui/separator/**",
    "src/components/ui/sheet/**",
    "src/components/ui/sidebar/**",
    "src/components/ui/skeleton/**",
    "src/components/ui/sonner/**",
    "src/components/ui/switch/**",
    "src/components/ui/table/**",
    "src/components/ui/tabs/**",
    "src/components/ui/textarea/**",
    "src/components/ui/tooltip/**"
  ]
}
